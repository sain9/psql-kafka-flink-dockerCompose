{
  "name": "csv-file-source-connector",
  "config": {
    "connector.class": "com.github.jcustenborder.kafka.connect.spooldir.SpoolDirCsvSourceConnector",
    "tasks.max": "1",
    "topic": "array-events-topic",
    "input.path": "/home/hussain/Downloads/kafka-connect-kafka-sink-connector-csv/src/main/resources/custom_csv",
    "input.file.pattern": "events.csv",
    "finished.path": "/home/hussain/Downloads/kafka-connect-kafka-sink-connector-csv/src/main/resources/custom_csv/processed",
    "error.path": "/home/hussain/Downloads/kafka-connect-kafka-sink-connector-csv/src/main/resources/custom_csv/error",
    "halt.on.error": "false",
    "csv.first.row.as.header": "true",
    "csv.separator.char": ",",
    "schema.generation.enabled": "true",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false"
  }
}
